<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="end|bottom"
        android:padding="24dp"
        android:text="0"
        android:textColor="#212121"
        android:textSize="36sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins">

        <Button android:id="@+id/btnClear" android:text="C" android:textColor="#D32F2F" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btnBackspace" android:text="⌫" android:textColor="#1976D2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btnDivide" android:text="÷" android:textColor="#1976D2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btnMultiply" android:text="×" android:textColor="#1976D2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button android:id="@+id/btn7" android:text="7" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btnMinus" android:text="−" android:textColor="#1976D2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button android:id="@+id/btn4" android:text="4" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btnPlus" android:text="+" android:textColor="#1976D2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button android:id="@+id/btn1" android:text="1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        
        <Button
            android:id="@+id/btnEquals"
            android:text="="
            android:layout_rowSpan="2"
            android:layout_gravity="fill"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF" />

        <Button android:id="@+id/btn0" android:text="0" android:layout_columnSpan="2" android:layout_gravity="fill_horizontal" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/btnDot" android:text="." style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </GridLayout>

</LinearLayout>

